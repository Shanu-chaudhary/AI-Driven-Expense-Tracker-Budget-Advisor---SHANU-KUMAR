# Copy this to `application-secret.properties` (gitignored) and fill with real secrets.
# Do NOT commit the real file.

# JWT secret (long random string)
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional: override expiration (milliseconds)
jwt.expiration=3600000

# Mail credentials
spring.mail.username=you@example.com
spring.mail.password=your-email-password

# Optional Mongo override
spring.data.mongodb.uri=mongodb://localhost:27017/mydb

# For gemini
GEMINI_API_KEY=
AI_ENABLED=true
AI_RATE_LIMIT=10


# application properties
gemini.api.enabled=
gemini.model=
gemini.api.key=
gemini.api.Url=
gemini.api.rateLimit.maxCallsPerHour=

spring.config.import=optional:classpath:application-secret.properties


spring.mail.host=smtp.gmail.com
spring.mail.port=587

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

spring.application.name=backend

server.port=8080
